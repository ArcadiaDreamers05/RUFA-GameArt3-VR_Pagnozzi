# Normalise line endings; Unity reads LF and CRLF alike.
* text=auto
# Unity writes its own text files with LF: check them out the same way, so opening the project marks nothing as modified.
# text=auto still decides what is text, so binary .asset files (lightmap data, for instance) stay untouched.
*.asset eol=lf
*.json eol=lf
*.unity eol=lf
*.prefab eol=lf
*.mat eol=lf
*.meta eol=lf
# Shell scripts stay LF on every checkout: bash stops at a carriage return.
*.sh text eol=lf

# Binary assets go to Git LFS.
*.fbx filter=lfs diff=lfs merge=lfs -text
